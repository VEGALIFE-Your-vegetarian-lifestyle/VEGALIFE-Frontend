VITE_API_BASE_URL=https://vegalife-backend.onrender.com
# VITE_MAP_API_URL=
# VITE_MAP_API_KEY=

# Vite — copy to Apps/web/.env
VITE_PORT=5174
# Primary API (Vercel). Dev probes this first.
# VITE_API_URL=https://becorestaff.vercel.app
# Fallback when remote healthz fails (npm run dev:web only). Production build ignores this.
VITE_API_FALLBACK_URL=http://localhost:3000

# Google OAuth 2.0 (Google Identity Services)
VITE_GOOGLE_CLIENT_ID=
# Usually http://localhost:5173/login (must match Google Console and Backend GOOGLE_REDIRECT_URI) or postmessage
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/login
# 'redirect' (recommended if Authorized JavaScript Origins is not set in Google Console) or 'popup'
VITE_GOOGLE_UX_MODE=redirect

